# Exclude TypeScript declaration files from container images
# These are only needed during development and build time, not runtime
**/*.d.ts
*.d.ts

# Exclude TypeScript source files (only compiled JS needed in runtime)
**/*.ts
*.ts
!validation-sidecar.ts
!api.ts
!appconfig.ts
!env-config.ts

# Exclude development files
node_modules
.git
.gitignore
*.md
README*
tsconfig.json
package-lock.json

# Exclude build artifacts that aren't needed
*.map
*.tsbuildinfo

# Exclude test files
**/*.test.ts
**/*.spec.ts
__tests__
test
tests
