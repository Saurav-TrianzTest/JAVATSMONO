# Dockerfile for Validation Sidecar Container
# Multi-stage build for optimized container size

# Stage 1: Build
FROM node:18-alpine AS builder

WORKDIR /app

# Copy package files
COPY ts-frontend/package.json ts-frontend/package-lock.json* ./

# Install dependencies
RUN npm ci --only=production

# Copy TypeScript source files
COPY ts-frontend/validation-sidecar.ts ./
COPY ts-frontend/api.ts ./
COPY ts-frontend/appconfig.ts ./
COPY ts-frontend/env-config.ts ./
COPY ts-frontend/tsconfig.json ./
COPY ts-frontend/tsconfig.prod.json ./
COPY ts-frontend/.dockerignore ./

# Build TypeScript using production config (excludes .d.ts files)
# Rule cz-ts-1003: Exclude TypeScript declaration files from container
RUN npm install -g typescript && tsc --project tsconfig.prod.json

# Stage 2: Runtime
FROM node:18-alpine

WORKDIR /app

# Install curl for health checks
RUN apk add --no-cache curl

# Copy built files and dependencies from builder
COPY --from=builder /app/node_modules ./node_modules
COPY --from=builder /app/*.js ./

# Create non-root user for security
RUN addgroup -g 1001 -S nodejs && \
    adduser -S nodejs -u 1001

USER nodejs

# Expose sidecar port
EXPOSE 8080

# Health check
HEALTHCHECK --interval=30s --timeout=5s --start-period=60s --retries=3 \
  CMD curl -f http://localhost:8080/health || exit 1

# Start validation sidecar
CMD ["node", "validation-sidecar.js"]
